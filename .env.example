ALCHEMY_API_KEY=
RPC_FAST_API_KEY=
DUNE_SIM_API_KEY=
GOLDRUSH_API_KEY=
COINGECKO_API_KEY=
NANSEN_API_KEY=
BITQUERY_TOKEN=
ZERION_API_KEY=
X402_MARKET_FETCH_LIMIT=100
X402_MARKET_JSON_OUTPUT_PATH=./reports/x402-market-snapshot.json
X402_MARKET_MARKDOWN_OUTPUT_PATH=./reports/x402-market-summary.md
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=
HITPAY_MPP_ENDPOINT=https://sandbox.mpp.hitpay.dev
STRIPE_SECRET_KEY=
MPPX_PRIVATE_KEY=
MPP_SECRET_KEY=
SOLANA_MPP_RECIPIENT=
SOLANA_MPP_NETWORK=devnet
SOLANA_MPP_CURRENCY=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_MPP_SECRET_KEY=
# Optional override for the Solana RPC endpoint used by @solana/mpp.
# When unset, the SDK uses the public devnet RPC (https://api.devnet.solana.com),
# which periodically returns stale blockhashes and causes "Verification Failed".
# Set this to a Helius / QuickNode / Alchemy devnet endpoint to avoid that.
SOLANA_MPP_RPC_URL=
# Server-side payer wallet for the showcase "Pay with Solana wallet" button.
# Accepts either the Solana CLI keypair JSON array (64 numbers) or a base58-encoded
# 64-byte secret key. The wallet must hold devnet SOL (for fees) and devnet USDC.
SOLANA_MPP_PAYER_PRIVATE_KEY=
# x402 discovery refresh (AEO). The BFF holds the latest facilitator discovery
# JSON in memory, seeded from committed slim snapshots. An external cron POSTs
# `/aeo/x402/refresh` with this bearer token to pull fresh data from the CDP,
# Dexter, and PayAI registries, swap it in, and persist it to disk (so the next
# startup loads it). Leave empty to DISABLE the refresh endpoint (it returns 403).
# Only trusted callers should hold this token, e.g.:
#   curl -fsS -X POST -H "Authorization: Bearer $BFF_X402_REFRESH_TOKEN" \
#     https://<bff-host>/aeo/x402/refresh
# In production this is auto-generated per deploy by deploy-lightsail-shared.yml
# and a host cron (scripts/deploy/x402-refresh.sh) POSTs the refresh twice a day;
# only set this for local runs.
BFF_X402_REFRESH_TOKEN=
# LLM / upsell customer routes (Bedrock / Qvac inference) are gated behind an
# API key so a public demo cannot burn vendor cost. Leave empty to DISABLE the
# LLM routes (they return 403). When set, callers must present it as
# `Authorization: Bearer <key>` or the `x-llm-api-key` header, e.g.:
#   curl -H "Authorization: Bearer $BFF_LLM_API_KEY" \
#     https://<bff-host>/customers/<address>/llm/upsell-explanation
# The frontend forwards this key server-side (apps/frontend/proxy.ts) when it
# is also set in the frontend environment. In production, set it via the
# BFF_LLM_API_KEY repository secret; leave it unset to keep the public demo
# gated off.
BFF_LLM_API_KEY=
# Per-key request quota for the gated LLM routes (fixed window).
BFF_LLM_QUOTA_MAX=30
BFF_LLM_QUOTA_WINDOW_MS=60000
# Optional: override the directory of slim x402 discovery seed files (the
# committed read-only baseline). Defaults to the BFF's bundled
# apps/bff/data/x402-discovery (regenerate via `bun run scripts/seed-x402-discovery.ts`).
# BFF_X402_DISCOVERY_DIR=
# Optional: writable directory the refresh job persists fetched data to and that
# startup loads from first (falling back to the seed dir above). In production,
# point this at the mounted volume so refreshed data survives redeploys.
# BFF_X402_DISCOVERY_DATA_DIR=/data/x402-discovery
