# Copy to the repo-root .env (git-ignored) or export in your shell.
# Read by both the Stellar CLI and HANDLE scripts.
STELLAR_NETWORK=testnet
# Optional on testnet (defaults to the SDF RPC).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# The CLI requires this whenever STELLAR_RPC_URL is set; HANDLE checks it matches STELLAR_NETWORK.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# CLI identity name from `stellar keys generate handle-admin`; not a secret.
STELLAR_ACCOUNT=handle-admin
# Set after `stellar contract deploy`.
REGISTRY_CONTRACT_ID=
# Optional; must equal the Testnet USDC SAC if set.
USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Provider owner secret for seed-providers.ts — Testnet only; load Public secrets from a secret store.
DEMO_PROVIDER_SECRET=
