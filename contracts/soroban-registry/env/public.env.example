# Public (mainnet). Blocked until docs/stellar-mainnet-go-live-checklist.md
# has a signed GO. Keep this in a separate shell/env file from Testnet.
STELLAR_NETWORK=public
# Required: there is no SDF-hosted Public RPC. Use your RPC provider's URL.
STELLAR_RPC_URL=
# The CLI requires this whenever STELLAR_RPC_URL is set; HANDLE checks it matches STELLAR_NETWORK.
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# CLI identity backed by a hardware wallet / secret store, never a committed seed.
STELLAR_ACCOUNT=handle-admin-public
REGISTRY_CONTRACT_ID=
# Optional; must equal the Public USDC SAC if set.
USDC_SAC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
